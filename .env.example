# Base App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider: "mock" (built-in NLP rule-based engine) or "llm" (external API)
AI_PROVIDER="mock"
AI_API_KEY=""

# Operator dashboard demo authentication
OPERATOR_SECRET_KEY="bhopal-admin-2026"
