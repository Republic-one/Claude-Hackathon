# Environment Configuration for Bhopal Civic Complaint Intelligence & Triage System

# Database connection (SQLite default for zero-setup local execution)
DATABASE_URL="file:./dev.db"

# Hackathon Demo Mode flag
DEMO_MODE="true"

# Optional Map API key (Leaflet will use free OpenStreetMap tiles gracefully if empty)
